{
  "expo": {
    "name": "Upande Sensors",
    "slug": "upande-sensors",
    "version": "1.0.10",
    "runtimeVersion": "1.0",
    "updates": {
      "enabled": true,
      "url": "https://sensor.upande.com/api/method/upande_sensors.api.ota.manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.upande.sensors"
    },
    "android": {
      "package": "com.upande.sensors",
      "versionCode": 5010,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "githubRepo": "WilfredTinega/Upande-Sensors-App",
      "otaBaseUrl": "https://wilfredtinega.github.io/Upande-Sensors-App/ota"
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      "./plugins/withBuildTuning",
      "expo-secure-store",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Upande Sensors to unlock with Face ID."
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#2a78d6"
        }
      ]
    ]
  }
}
