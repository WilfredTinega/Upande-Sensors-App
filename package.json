    "build:apk": "npm run prebuild && cd android && ./gradlew assembleRelease",
    "server:deploy": "node server/deploy.mjs",
    "server:deploy:dry": "node server/deploy.mjs --dry-run",
    "server:verify": "node server/deploy.mjs --verify",
    "test:cache": "node tests/cache.test.js",
    "test": "node tests/routeHistory.test.js && node tests/cache.test.js"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0"
  },
