  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.0",
    "expo": "^57.0.22",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-intent-launcher": "~57.0.1",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.17",
    "expo-notifications": "~57.0.18",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-webview": "13.16.1",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "doctor": "npx --yes expo-doctor",
    "test:route-history": "node tests/routeHistory.test.js",
    "prebuild": "expo prebuild --platform android --clean",
    "version:next": "node scripts/version.mjs",
    "version:apply": "node scripts/version.mjs --apply",
    "version:notes": "node scripts/version.mjs --notes",
    "build:apk": "npm run prebuild && cd android && ./gradlew assembleRelease",
    "server:deploy": "node server/deploy.mjs",
    "server:deploy:dry": "node server/deploy.mjs --dry-run",
    "server:verify": "node server/deploy.mjs --verify",
    "test:cache": "node tests/cache.test.js",
    "test": "node tests/routeHistory.test.js && node tests/cache.test.js && node tests/updateKind.test.js && node tests/endpointsChain.test.js && node tests/dashboardHealth.test.js && node tests/alerts.test.js && node tests/geo.test.js",
    "test:update-kind": "node tests/updateKind.test.js",
    "ota:build": "node scripts/publish-ota.mjs",
    "android:emulator": "expo run:android -- -PreactNativeArchitectures=x86_64",
    "test:endpoints-chain": "node tests/endpointsChain.test.js",
    "test:dashboard-health": "node tests/dashboardHealth.test.js",
    "test:alerts": "node tests/alerts.test.js",
    "test:geo": "node tests/geo.test.js"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2"
  },
