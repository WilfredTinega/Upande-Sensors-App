{
  "comment": "Server Script FALLBACK endpoints. The API now lives in the upande_sensors Frappe app as upande_sensors.api.mobile.<name> (upande_sensors/api/mobile.py); the client tries that first and falls to these upande_sensors_app.<name> scripts only when the app method is missing, then to the legacy calls. Keep params and response shapes identical to the app methods. `api_method` is the dotted path at /api/method/<api_method>; `file` is the script body under scripts/. Deploy with `npm run server:deploy`.",
  "namespace": "upande_sensors_app",
  "scripts": [
    { "api_method": "upande_sensors_app.whoami", "file": "whoami.py", "name": "App — Whoami", "method": "GET" },
